---
import { SITE_TITLE } from '../consts';
import { url } from '../utils';
const links = [
  { href: url('/'), label: '文章' },
  { href: url('/tags/'), label: '标签' },
  { href: url('/about/'), label: '关于' },
];
---
<header>
  <a class="brand" href={url('/')}>{SITE_TITLE}</a>
  <nav>{links.map((l) => <a href={l.href}>{l.label}</a>)}</nav>
</header>
<style>
  header { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: .5rem; padding: 2rem 0 2.5rem; }
  .brand { font-weight: 600; color: var(--fg); }
  nav a { margin-left: 1.2rem; color: var(--muted); }
  nav a:first-child { margin-left: 0; }
  nav a:hover { color: var(--fg); text-decoration: none; }
</style>
