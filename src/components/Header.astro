---
import { SITE_TITLE } from '../consts';
import { url } from '../utils';
const path = Astro.url.pathname;
const links = [
  { href: url('/'), label: '文章' },
  { href: url('/map/'), label: '地图' },
  { href: url('/tags/'), label: '标签' },
  { href: url('/about/'), label: '关于' },
];
---
<header class="site-header">
 <div class="bar glass">
  <a class="brand" href={url('/')}><span class="logo" aria-hidden="true">W</span>{SITE_TITLE}</a>
  <nav>
    {links.map((l) => {
      // 文章页归到“文章”，标签详情页归到“标签”
      const active = l.href === url('/') ? path === l.href || path.startsWith(url('/posts/')) : path.startsWith(l.href);
      return <a href={l.href} class:list={{ active }} aria-current={active ? 'page' : undefined}>{l.label}</a>;
    })}
    <button class="theme" type="button" aria-label="切换夜间模式" title="切换夜间模式">
      <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" /><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" /></svg>
      <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z" /></svg>
    </button>
  </nav>
 </div>
</header>
<script>
  const btn = document.querySelector<HTMLButtonElement>('.site-header .theme')!;
  const root = document.documentElement;
  const system = matchMedia('(prefers-color-scheme: dark)');
  const isDark = () => (root.dataset.theme ?? (system.matches ? 'dark' : 'light')) === 'dark';
  const sync = () => btn.setAttribute('aria-pressed', String(isDark()));
  sync();
  system.addEventListener('change', sync);
  btn.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
    sync();
  });
</script>
<style>
  /* 顶部导航：悬浮的玻璃条，滚动时保持在顶部 */
  .site-header { position: sticky; top: 0; z-index: 20; padding: .9rem 1rem 0; margin-bottom: 2.2rem; }
  .bar { max-width: 68rem; margin: 0 auto; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: .5rem; padding: .5rem .6rem .5rem 1rem; border-radius: 999px; }
  .brand { display: inline-flex; align-items: center; gap: .55rem; font-weight: 650; color: var(--fg); letter-spacing: .01em; }
  .brand:hover { text-decoration: none; }
  .logo { display: grid; place-items: center; width: 1.7rem; height: 1.7rem; border-radius: 50%; font-size: .85rem; font-weight: 700; color: #fff; background: linear-gradient(135deg, #4f8cff, #a46bf5 60%, #f472b6); box-shadow: 0 4px 12px -4px rgb(79 140 255 / .6); }
  nav { display: flex; align-items: center; gap: .15rem; }
  nav a { padding: .32rem .85rem; border-radius: 999px; color: var(--muted); font-size: .95rem; transition: color .15s, background-color .15s; }
  nav a:hover { color: var(--fg); background: var(--hover); text-decoration: none; }
  nav a.active { color: var(--accent); background: var(--active-bg); font-weight: 600; }
  .theme { margin-left: .3rem; width: 2.1rem; height: 2.1rem; display: grid; place-items: center; padding: 0; border: 0; background: none; color: var(--muted); cursor: pointer; border-radius: 50%; transition: background-color .15s, color .15s; }
  .theme:hover { color: var(--fg); background: var(--hover); }
  .theme svg { width: 1.05rem; height: 1.05rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .theme .moon { display: none; }
  .theme[aria-pressed="true"] .sun { display: none; }
  .theme[aria-pressed="true"] .moon { display: block; }
  @media (max-width: 34rem) {
    .site-header { padding: .6rem .6rem 0; margin-bottom: 1.5rem; }
    .bar { border-radius: 18px; padding: .45rem .5rem .45rem .8rem; }
    .brand { font-size: .95rem; }
    nav a { padding: .28rem .6rem; font-size: .9rem; }
  }
</style>
