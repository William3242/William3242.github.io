---
export interface TocNode {
  depth: number;
  slug: string;
  text: string;
  children: TocNode[];
}
interface Props {
  nodes: TocNode[];
}
const { nodes } = Astro.props;
---
<ol>
  {nodes.map((n) => (
    <li class={`d${n.depth}`} data-slug={n.slug}>
      <div class="row">
        {n.children.length > 0 ? (
          <button class="tw" type="button" aria-expanded="true" aria-label={`展开或收起：${n.text}`}>
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 4l4 4-4 4" /></svg>
          </button>
        ) : <span class="tw-gap" />}
        <a href={`#${n.slug}`}>{n.text}</a>
      </div>
      {n.children.length > 0 && <Astro.self nodes={n.children} />}
    </li>
  ))}
</ol>
