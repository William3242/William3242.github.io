---
import type { CollectionEntry } from 'astro:content';
import { formatDate, url } from '../utils';
interface Props { posts: CollectionEntry<'posts'>[] }
const { posts } = Astro.props;
---
<ul>
  {posts.map((p) => (
    <li>
      <time class="muted">{formatDate(p.data.pubDate)}</time>
      <a href={url(`/posts/${p.id}/`)}>{p.data.title}</a>
    </li>
  ))}
</ul>
<style>
  ul { list-style: none; padding: 0; margin: 0; }
  li { display: flex; gap: 1.2rem; padding: .35rem 0; }
  time { flex-shrink: 0; font-variant-numeric: tabular-nums; font-size: .92rem; }
</style>
