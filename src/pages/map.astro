---
import Base from '../layouts/Base.astro';
import { LAYERS, CROSS, type MapNode } from '../data/stack-map';
import { getPublishedPosts, url } from '../utils';

// 只有文章真实存在（且已发布）时节点才可点击，避免出现死链
const published = new Set((await getPublishedPosts()).map((p) => p.id));
const href = (n: MapNode) => (n.post && published.has(n.post) ? url(`/posts/${n.post}/`) : null);

const all = [...LAYERS, CROSS].flatMap((l) => l.nodes);
const written = all.filter((n) => href(n)).length;
const pct = Math.round((written / all.length) * 100);
---
<Base title="Agent 技术地图" description="AI 应用与 Agent 开发的分层技术地图：应用层、编排层、能力接入层、模型层、推理与基础设施，以及贯穿各层的评测、可观测性、成本与安全。">
  <div class="atlas">
    <header class="hero">
      <p class="eyebrow">Stack Map · 技术地图</p>
      <h1>Agent 技术地图 <span>The Agent Stack</span></h1>
      <p class="lede">从用户看到的产品，到底层的算力，把 AI 应用和 Agent 开发拆成五层。实线节点可以点开阅读，虚线是还没写到的部分。</p>
      <div class="meta">
        <span class="key"><i class="sw on"></i>已有文章 Written</span>
        <span class="key"><i class="sw off"></i>待写 Planned</span>
        <span class="progress" aria-label={`已写 ${written} / ${all.length}`}>
          <span class="bar"><b style={`width:${pct}%`}></b></span>
          <span class="num">{written}<em>/{all.length}</em></span>
        </span>
      </div>
    </header>

    <div class="board">
      <ol class="layers">
        {LAYERS.map((layer, i) => (
          <li class={`layer l-${layer.key}`}>
            <div class="label">
              <span class="idx">{String(i + 1).padStart(2, '0')}</span>
              <h2>{layer.zh}</h2>
              <p class="en">{layer.en}</p>
              <p class="hint">{layer.hint}</p>
            </div>
            <ul class="nodes">
              {layer.nodes.map((n) => {
                const h = href(n);
                return (
                  <li>
                    {h ? (
                      <a class="node on" href={h}>
                        <span class="zh">{n.zh}</span>
                        <span class="nen">{n.en}</span>
                        <svg class="go" viewBox="0 0 12 12" aria-hidden="true"><path d="M3.5 8.5l5-5M4.5 3.5h4v4" /></svg>
                      </a>
                    ) : (
                      <span class="node off">
                        <span class="zh">{n.zh}</span>
                        <span class="nen">{n.en}</span>
                      </span>
                    )}
                  </li>
                );
              })}
            </ul>
          </li>
        ))}
      </ol>

      <aside class="layer cross l-cross" aria-label={`${CROSS.zh} ${CROSS.en}`}>
        <div class="label">
          <span class="idx">∞</span>
          <h2>{CROSS.zh}</h2>
          <p class="en">{CROSS.en}</p>
          <p class="hint">{CROSS.hint}</p>
        </div>
        <ul class="nodes">
          {CROSS.nodes.map((n) => {
            const h = href(n);
            return (
              <li>
                {h ? (
                  <a class="node on" href={h}>
                    <span class="zh">{n.zh}</span>
                    <span class="nen">{n.en}</span>
                    <svg class="go" viewBox="0 0 12 12" aria-hidden="true"><path d="M3.5 8.5l5-5M4.5 3.5h4v4" /></svg>
                  </a>
                ) : (
                  <span class="node off">
                    <span class="zh">{n.zh}</span>
                    <span class="nen">{n.en}</span>
                  </span>
                )}
              </li>
            );
          })}
        </ul>
      </aside>
    </div>

    <p class="foot">上层调用下层，越往下越接近模型和算力。<span>Upper layers build on the ones below.</span></p>
  </div>
</Base>

<style>
  /* 地图比正文更宽：从 42rem 的正文栏里向两侧撑开 */
  .atlas {
    --w: min(68rem, calc(100vw - 2rem));
    width: var(--w);
    margin-left: calc(50% - var(--w) / 2);
    --c-app: #7a6fd0;
    --c-harness: #4d6bfe;
    --c-cap: #3d8f6e;
    --c-model: #a0823c;
    --c-infra: #c0625a;
    --c-cross: #6b7280;
    --card: var(--glass);
    --shadow: 0 1px 2px rgb(31 35 40 / .04), 0 8px 24px -12px rgb(31 35 40 / .12);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .atlas {
      --c-app: #a371f7; --c-harness: #58a6ff; --c-cap: #3fb950; --c-model: #d29922; --c-infra: #ff7b72; --c-cross: #8b949e;
      --card: var(--glass);
      --shadow: 0 1px 2px rgb(0 0 0 / .3), 0 10px 30px -14px rgb(0 0 0 / .6);
    }
  }
  :root[data-theme="dark"] .atlas {
    --c-app: #a371f7; --c-harness: #58a6ff; --c-cap: #3fb950; --c-model: #d29922; --c-infra: #ff7b72; --c-cross: #8b949e;
    --card: var(--glass);
    --shadow: 0 1px 2px rgb(0 0 0 / .3), 0 10px 30px -14px rgb(0 0 0 / .6);
  }
  .l-app { --c: var(--c-app); }
  .l-harness { --c: var(--c-harness); }
  .l-cap { --c: var(--c-cap); }
  .l-model { --c: var(--c-model); }
  .l-infra { --c: var(--c-infra); }
  .l-cross { --c: var(--c-cross); }

  /* 标题区 */
  .hero { max-width: 42rem; margin: 0 0 2.2rem; }
  .eyebrow { margin: 0 0 .6rem; font-size: .72rem; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); font-weight: 600; }
  h1 { font-size: 2.1rem; letter-spacing: -.01em; margin: 0 0 .7rem; }
  h1 span { display: block; font-size: 1rem; font-weight: 500; letter-spacing: .02em; color: var(--muted); margin-top: .25rem; }
  .lede { margin: 0 0 1.2rem; color: var(--muted); font-size: .98rem; line-height: 1.7; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem 1.4rem; font-size: .8rem; color: var(--muted); }
  .key { display: inline-flex; align-items: center; gap: .45rem; }
  .sw { display: inline-block; width: 1.1rem; height: .75rem; border-radius: 4px; }
  .sw.on { background: color-mix(in srgb, var(--accent) 14%, var(--bg)); border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent); }
  .sw.off { border: 1px dashed var(--muted); opacity: .7; }
  .progress { display: inline-flex; align-items: center; gap: .55rem; margin-left: auto; }
  .bar { display: block; width: 6rem; height: 4px; border-radius: 99px; background: var(--border); overflow: hidden; }
  .bar b { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--c-app), var(--c-harness), var(--c-cap)); }
  .num { font-variant-numeric: tabular-nums; color: var(--fg); font-weight: 600; }
  .num em { font-style: normal; color: var(--muted); font-weight: 400; }

  /* 主体：左边五层，右边一条贯穿的横切关注点 */
  .board { display: grid; grid-template-columns: minmax(0, 1fr) 13rem; gap: .9rem; align-items: stretch; }
  .layers { list-style: none; margin: 0; padding: 0; display: grid; gap: .65rem; }
  ul.nodes { list-style: none; margin: 0; padding: 0; }

  .layer {
    position: relative;
    display: grid;
    grid-template-columns: 11.5rem minmax(0, 1fr);
    gap: 1.2rem;
    padding: 1.05rem 1.15rem 1.05rem 1.35rem;
    border: 1px solid var(--border);
    border-radius: 18px;
    background:
      radial-gradient(120% 140% at 0% 0%, color-mix(in srgb, var(--c) 9%, transparent), transparent 55%),
      var(--card);
    box-shadow: var(--shadow);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border-color: var(--glass-border);
    overflow: hidden;
  }
  .layer::before {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
    background: linear-gradient(180deg, var(--c), color-mix(in srgb, var(--c) 30%, transparent));
  }
  .label { min-width: 0; }
  .idx { display: inline-block; font: 600 .72rem/1 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; letter-spacing: .08em; color: var(--c); padding: .28rem .45rem; border-radius: 6px; background: color-mix(in srgb, var(--c) 12%, transparent); margin-bottom: .55rem; }
  .label h2 { margin: 0; font-size: 1.08rem; line-height: 1.35; }
  .label .en { margin: .1rem 0 0; font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; color: var(--c); font-weight: 600; line-height: 1.5; }
  .label .hint { margin: .45rem 0 0; font-size: .78rem; line-height: 1.5; color: var(--muted); }

  .layer .nodes { display: flex; flex-wrap: wrap; align-content: center; gap: .5rem; }
  .node {
    position: relative;
    display: flex; flex-direction: column; justify-content: center;
    min-height: 3.1rem;
    padding: .42rem 1.6rem .42rem .8rem;
    border-radius: 10px;
    line-height: 1.3;
    transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease, background-color .18s ease;
  }
  .zh { font-size: .9rem; font-weight: 600; color: var(--fg); }
  .nen { font-size: .7rem; letter-spacing: .02em; color: var(--muted); margin-top: .12rem; }
  .node.on {
    border: 1px solid color-mix(in srgb, var(--c) 32%, var(--border));
    background: color-mix(in srgb, var(--c) 7%, var(--bg));
  }
  .node.on:hover, .node.on:focus-visible {
    text-decoration: none;
    transform: translateY(-2px);
    border-color: var(--c);
    background: color-mix(in srgb, var(--c) 12%, var(--bg));
    box-shadow: 0 6px 18px -8px color-mix(in srgb, var(--c) 55%, transparent);
  }
  .node.on:focus-visible { outline: 2px solid var(--c); outline-offset: 2px; }
  .go { position: absolute; top: .45rem; right: .45rem; width: .75rem; height: .75rem; fill: none; stroke: var(--c); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; opacity: .55; transition: opacity .18s, transform .18s; }
  .node.on:hover .go { opacity: 1; transform: translate(1px, -1px); }
  .node.off { border: 1px dashed color-mix(in srgb, var(--muted) 45%, transparent); background: transparent; padding-right: .8rem; }
  .node.off .zh { color: var(--muted); font-weight: 500; }
  .node.off .nen { opacity: .7; }

  /* 横切关注点：竖向贯穿，用细斜纹区分 */
  .cross { grid-template-columns: 1fr; grid-template-rows: auto 1fr; gap: 1rem; padding: 1.05rem 1rem 1.05rem 1.2rem;
    background:
      repeating-linear-gradient(135deg, color-mix(in srgb, var(--c) 6%, transparent) 0 1px, transparent 1px 9px),
      var(--card);
  }
  .cross .nodes { flex-direction: column; flex-wrap: nowrap; align-content: stretch; justify-content: space-evenly; }
  .cross .node { width: 100%; }

  .foot { margin: 1.2rem 0 0; font-size: .78rem; color: var(--muted); text-align: center; }
  .foot span { margin-left: .5rem; opacity: .75; }

  @media (prefers-reduced-motion: reduce) {
    .node, .go { transition: none; }
    .node.on:hover { transform: none; }
  }

  @media (max-width: 64rem) {
    .layer { grid-template-columns: 9.5rem minmax(0, 1fr); }
    .board { grid-template-columns: minmax(0, 1fr) 11.5rem; }
  }
  /* 平板与手机：横切关注点挪到底部，层标题放到节点上方 */
  @media (max-width: 50rem) {
    .board { grid-template-columns: 1fr; }
    .layer { grid-template-columns: 1fr; gap: .8rem; padding: 1rem 1rem 1rem 1.15rem; }
    .label { display: grid; grid-template-columns: auto 1fr; column-gap: .65rem; align-items: center; }
    .idx { grid-row: span 2; margin: 0; }
    .label .hint { grid-column: 1 / -1; margin-top: .35rem; }
    .cross .nodes { flex-direction: row; flex-wrap: wrap; }
    .cross .node { width: auto; }
    .progress { margin-left: 0; }
  }
  @media (max-width: 34rem) {
    h1 { font-size: 1.75rem; }
    .layer .nodes { display: grid; grid-template-columns: 1fr 1fr; }
    .node, .cross .node { width: 100%; min-height: 2.9rem; }
    .foot span { display: block; margin: .2rem 0 0; }
  }
</style>
