---
import Base from '../../layouts/Base.astro';
import { getPublishedPosts, url } from '../../utils';
const posts = await getPublishedPosts();
const counts = new Map<string, number>();
posts.forEach((p) => p.data.tags.forEach((t) => counts.set(t, (counts.get(t) ?? 0) + 1)));
const tags = [...counts].sort((a, b) => b[1] - a[1]);
const max = tags[0]?.[1] ?? 1;
// 单色系：文章越多颜色越深，保持素净
const tone = (n: number) => Math.round(14 + 46 * Math.sqrt((n - 1) / Math.max(1, max - 1)));
// 直径按文章数的平方根缩放，面积和篇数成正比
const size = (n: number) => Math.round(62 + 108 * Math.sqrt((n - 1) / Math.max(1, max - 1)));
// 估算标签文字宽度（以 em 计：中文约 1em，英文约 .6em），据此决定字号，保证一行放得下
const textEm = (t: string) => [...t].reduce((w, ch) => w + (/[\u2e80-\u9fff]/.test(ch) ? 1 : ch === ' ' ? .3 : .6), 0);
const fit = (t: string) => Math.min(0.15, 0.74 / Math.max(textEm(t), 2.4)).toFixed(3);
---
<Base title="标签" wide>
  <section class="hero">
    <h1>标签</h1>
    <p class="muted">{tags.length} 个标签，气泡越大文章越多。鼠标靠近会把气泡推开，点击进入。</p>
  </section>
  <div class="field glass" data-bubbles>
    {tags.map(([t, n], i) => (
      <a class="bubble" href={url(`/tags/${t}/`)} style={`--d:${size(n)}px;--t:${tone(n)}%;--k:${fit(t)}`} data-d={size(n)} title={`${t}：${n} 篇`}>
        <span class="name">{t}</span>
        <span class="n">{n}</span>
      </a>
    ))}
  </div>
</Base>

<script>
  // 轻量的气泡物理：向中心聚拢 + 互相碰撞 + 鼠标斥力，停下来后保留轻微的漂浮
  const field = document.querySelector<HTMLElement>('[data-bubbles]');
  if (field) {
    const els = [...field.querySelectorAll<HTMLAnchorElement>('.bubble')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    type B = { el: HTMLElement; r: number; base: number; x: number; y: number; vx: number; vy: number; ph: number };
    let W = 0, H = 0, scale = 1;
    const bs: B[] = els.map((el, i) => ({ el, base: Number(el.dataset.d) / 2, r: 0, x: 0, y: 0, vx: 0, vy: 0, ph: i * 1.7 }));
    const mouse = { x: -1e4, y: -1e4 };

    const layout = () => {
      W = field.clientWidth;
      // 窄屏时整体缩小，保证所有气泡放得下
      const area = bs.reduce((s, b) => s + Math.PI * b.base * b.base, 0);
      scale = Math.min(1, Math.max(0.72, Math.sqrt((W * W * 0.75 * 0.55) / area)));
      bs.forEach((b) => { b.r = b.base * scale; b.el.style.setProperty('--d', `${Math.round(b.r * 2)}px`); });
      const packed = bs.reduce((s, b) => s + Math.PI * b.r * b.r, 0);
      H = Math.max(420, Math.round(packed / W / 0.44));
      field.style.height = `${H}px`;
    };
    const seed = () => {
      // 从大到小沿螺旋摆放，作为初始位置
      bs.forEach((b, i) => {
        const a = i * 2.4, d = 42 * Math.sqrt(i) * scale;
        b.x = W / 2 + Math.cos(a) * d * W / (W + H) * 1.6;
        b.y = H / 2 + Math.sin(a) * d * H / (W + H) * 1.6;
      });
    };

    field.classList.add('live');
    layout();
    seed();

    let running = true, t = 0, calm = 0;
    const step = () => {
      t += 1;
      let energy = 0;
      for (const b of bs) {
        // 椭圆形的向心力，让气泡铺满横向空间
        b.vx += (W / 2 - b.x) * 0.0056 * H / (W + H);
        b.vy += (H / 2 - b.y) * 0.0056 * W / (W + H);
        const dx = b.x - mouse.x, dy = b.y - mouse.y, dist = Math.hypot(dx, dy), reach = b.r + 70;
        if (dist < reach && dist > 0) { const f = (reach - dist) / reach * 2.2; b.vx += dx / dist * f; b.vy += dy / dist * f; }
      }
      for (let i = 0; i < bs.length; i++) for (let j = i + 1; j < bs.length; j++) {
        const a = bs[i], c = bs[j];
        const dx = c.x - a.x, dy = c.y - a.y, min = a.r + c.r + 6, d = Math.hypot(dx, dy) || 0.01;
        if (d < min) {
          const push = (min - d) / d * 0.5, px = dx * push, py = dy * push;
          const wa = c.r / (a.r + c.r), wc = a.r / (a.r + c.r);
          a.x -= px * wa; a.y -= py * wa; c.x += px * wc; c.y += py * wc;
        }
      }
      for (const b of bs) {
        b.vx *= 0.82; b.vy *= 0.82;
        b.x += b.vx; b.y += b.vy;
        b.x = Math.min(W - b.r - 4, Math.max(b.r + 4, b.x));
        b.y = Math.min(H - b.r - 4, Math.max(b.r + 4, b.y));
        energy += b.vx * b.vx + b.vy * b.vy;
        const fx = reduce ? 0 : Math.sin(t / 60 + b.ph) * 3, fy = reduce ? 0 : Math.cos(t / 75 + b.ph) * 3;
        b.el.style.transform = `translate(${b.x - b.r + fx}px, ${b.y - b.r + fy}px)`;
      }
      calm = energy < 0.02 ? calm + 1 : 0;
      // 减少动态效果时，排好后就停止动画
      if (reduce && calm > 30) { running = false; return; }
      requestAnimationFrame(step);
    };
    requestAnimationFrame(step);

    field.addEventListener('pointermove', (e) => {
      const r = field.getBoundingClientRect();
      mouse.x = e.clientX - r.left; mouse.y = e.clientY - r.top;
      if (!running) { running = true; requestAnimationFrame(step); }
    });
    field.addEventListener('pointerleave', () => { mouse.x = mouse.y = -1e4; });
    let rt = 0;
    addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(() => { const ow = W; layout(); bs.forEach((b) => { b.x *= W / ow; }); if (!running) { running = true; requestAnimationFrame(step); } }, 120); });
  }
</script>

<style>
  .hero { margin: .5rem 0 1.6rem; }
  .hero h1 { font-size: 2.2rem; margin: 0 0 .3rem; }
  .hero p { margin: 0; }

  /* 没有 JS 时：普通的换行排列 */
  .field { position: relative; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: .8rem; padding: 1.5rem; border-radius: 24px; overflow: hidden; }
  .field.live { display: block; padding: 0; }
  .field.live .bubble { position: absolute; left: 0; top: 0; }

  .bubble {
    --c: var(--accent);
    width: var(--d); height: var(--d);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    border-radius: 50%; text-align: center; color: var(--fg); line-height: 1.2; padding: .3rem;
    background:
      radial-gradient(circle at 35% 28%, rgb(255 255 255 / .7), transparent 50%),
      color-mix(in srgb, var(--c) var(--t), var(--glass-strong));
    border: 1px solid color-mix(in srgb, var(--c) calc(var(--t) + 10%), var(--glass-border));
    box-shadow: 0 6px 18px -12px color-mix(in srgb, var(--c) 60%, transparent);
    -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
    transition: box-shadow .2s, background-color .2s;
    will-change: transform;
    user-select: none;
  }
  .bubble:hover { text-decoration: none; color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--c) 22%, transparent), 0 10px 24px -12px color-mix(in srgb, var(--c) 70%, transparent); z-index: 3; }
  .name { font-weight: 600; font-size: max(9px, calc(var(--d) * var(--k))); white-space: nowrap; }
  .n { font-size: clamp(.6rem, calc(var(--d) * .09), .9rem); color: var(--muted); font-variant-numeric: tabular-nums; margin-top: .1rem; }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .bubble { background: radial-gradient(circle at 35% 28%, rgb(255 255 255 / .1), transparent 50%), color-mix(in srgb, var(--c) var(--t), var(--glass-strong)); }
  }
  :root[data-theme="dark"] .bubble { background: radial-gradient(circle at 35% 28%, rgb(255 255 255 / .1), transparent 50%), color-mix(in srgb, var(--c) var(--t), var(--glass-strong)); }
</style>
